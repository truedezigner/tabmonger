---
import Layout from '../layouts/Layout.astro';
import Logo from '../components/Logo.astro';
import SupportIcon from '../components/SupportIcon.astro';

const githubUrl = 'https://github.com/truedezigner/tabmonger';
const downloadUrl = `${githubUrl}/releases/latest/download/TabMonger-portable.zip`;
const chromiumDownloadUrl = `${githubUrl}/releases/latest/download/TabMonger-Chromium-extension.zip`;
const firefoxDownloadUrl = `${githubUrl}/releases/latest/download/TabMonger-Firefox-extension.zip`;
const quickStartUrl = `${githubUrl}#quick-start`;
const extensionsUrl = `${githubUrl}/tree/main/extensions`;
const macSetupUrl = `${githubUrl}/blob/main/docs/INSTALL.md#macos`;
const chromiumSetupUrl = `${githubUrl}/blob/main/extensions/README.md#chrome-or-brave`;
const firefoxSetupUrl = `${githubUrl}/blob/main/extensions/README.md#firefox-development-install`;
const supportFlag = import.meta.env.PUBLIC_STRIPE_SUPPORT_READY?.trim().toLowerCase();
const supportCandidate = import.meta.env.PUBLIC_SUPPORT_URL?.trim() || import.meta.env.PUBLIC_STRIPE_SUPPORT_URL?.trim();
let supportUrl: string | undefined;
if (supportFlag === 'true') {
  if (!supportCandidate) throw new Error('Support checkout is marked ready but no Payment Link is configured.');
  let parsedSupportUrl: URL;
  try {
    parsedSupportUrl = new URL(supportCandidate);
  } catch {
    throw new Error('Configured support checkout is not a valid URL.');
  }
  const validStripeLink = parsedSupportUrl.protocol === 'https:'
    && parsedSupportUrl.hostname === 'buy.stripe.com'
    && parsedSupportUrl.port === ''
    && parsedSupportUrl.username === ''
    && parsedSupportUrl.password === ''
    && parsedSupportUrl.pathname.length > 1
    && parsedSupportUrl.hash === '';
  if (!validStripeLink) throw new Error('Configured support checkout must be an HTTPS buy.stripe.com Payment Link.');
  supportUrl = parsedSupportUrl.href;
}
const supportReady = Boolean(supportUrl);

const features = [
  ['Everything in its place', 'Pin favorites, drag to reorder, organize with tags, search locally, and recover links from the trash.'],
  ['Search without surrender', 'Use your own SearXNG first, search saved links instantly, and keep provider choices to two clear options.'],
  ['Quiet service awareness', 'See whether private services are reachable without making every browser tab hammer your network.'],
  ['Make it yours', 'Upload a background and icons, tune bright tiles individually, choose light or dark mode, and add trusted custom CSS.'],
  ['Bring everything with you', 'Import older dashboard data or browser bookmarks, then export one portable JSON backup with settings and assets.'],
  ['Small on purpose', 'One Python standard-library process, SQLite, plain HTML/CSS/JavaScript, and no runtime package installation.']
];

const steps = [
  ['1', 'Download', 'Grab one ZIP from GitHub or clone the repository.'],
  ['2', 'Start', 'Run the small Python 3.10+ server on Linux, macOS, Windows, a NAS, or a home server.'],
  ['3', 'Connect', 'Open the LAN address from any computer on your network.']
];
---
<Layout>
  <header class="site-header shell">
    <a href="#top" class="brand-link" aria-label="TabMonger home"><Logo /></a>
    <nav aria-label="Main navigation">
      <a href="#features">Features</a>
      <a href="#downloads">Downloads</a>
      <a href="#use-everywhere">Use everywhere</a>
      <a href="#community">Community</a>
      <a href={githubUrl}>GitHub</a>
    </nav>
    <a class="button button-small coffee-button" href={supportReady ? supportUrl : '#support'} target={supportReady ? '_blank' : undefined} rel={supportReady ? 'noopener' : undefined} aria-label="Support TabMonger with an optional one-time contribution">
      <SupportIcon /> Support
    </a>
  </header>

  <main id="top">
    <section class="hero shell">
      <div class="hero-copy">
        <p class="eyebrow"><span></span> Self-hosted. Private. Tiny.</p>
        <h1>Your tabs.<br /><em>Your server.</em><br />Your rules.</h1>
        <p class="hero-lede">TabMonger is a fast, dependency-free home for every link and service you use—without turning your new tab into another cloud account.</p>
        <div class="hero-actions">
          <a class="button button-primary" href={downloadUrl}>Download TabMonger <span aria-hidden="true">↓</span></a>
          <a class="button" href="#install">See the simple setup</a>
        </div>
        <p class="hero-note">Free and open source, always. No telemetry. No account. Built to be extended.</p>
      </div>

      <div class="dashboard-stage" aria-label="TabMonger dashboard preview">
        <div class="glow"></div>
        <article class="dashboard-demo">
          <div class="demo-topbar">
            <Logo compact={true} />
            <div class="demo-date"><b>Thursday</b><span>August 20</span></div>
            <div class="demo-weather"><span>☀</span><b>72°</b></div>
            <button aria-label="Settings">⌁</button>
          </div>
          <div class="demo-search">
            <span>SearXNG</span>
            <p>Search the web or your links…</p>
            <kbd>/</kbd>
          </div>
          <div class="demo-tabs"><b>Pinned</b><span>All links</span><span>Tags</span><i>7 services up</i></div>
          <div class="demo-grid">
            <div class="demo-tile violet"><span>OW</span><p><b>Open WebUI</b><small>Local AI</small></p><i class="up"></i></div>
            <div class="demo-tile blue"><span>JF</span><p><b>Jellyfin</b><small>Media</small></p><i class="up"></i></div>
            <div class="demo-tile orange"><span>CF</span><p><b>Cloudflare</b><small>Network</small></p><i class="up"></i></div>
            <div class="demo-tile teal"><span>SE</span><p><b>SearXNG</b><small>Search</small></p><i class="up"></i></div>
            <div class="demo-tile slate"><span>GH</span><p><b>GitHub</b><small>Development</small></p><i></i></div>
            <div class="demo-tile red"><span>PX</span><p><b>Proxmox</b><small>Infrastructure</small></p><i class="up"></i></div>
          </div>
        </article>
      </div>
    </section>

    <section class="proof-strip" aria-label="Technical summary">
      <div class="shell proof-grid">
        <p><b>No account</b><span>Nothing to sign into</span></p>
        <p><b>0</b><span>Third-party runtime packages</span></p>
        <p><b>1</b><span>Small Python process</span></p>
        <p><b>100%</b><span>Your data, locally</span></p>
      </div>
    </section>

    <section class="section shell" id="features">
      <div class="section-heading">
        <p class="eyebrow"><span></span> Full-featured, not full-sized</p>
        <h2>The useful parts of a dashboard.<br /><em>None of the baggage.</em></h2>
        <p>TabMonger keeps the dashboard features you actually touch every day, then adds careful search, portability, and service awareness.</p>
      </div>
      <div class="feature-grid">
        {features.map(([title, body], index) => (
          <article class="feature-card">
            <span class="feature-number">0{index + 1}</span>
            <div class={`feature-icon icon-${index + 1}`} aria-hidden="true"><i></i><i></i><i></i></div>
            <h3>{title}</h3>
            <p>{body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section light-story" id="how-it-stays-light">
      <div class="shell story-grid">
        <div class="story-copy">
          <p class="eyebrow dark"><span></span> Deliberately lightweight</p>
          <h2>Opening ten tabs should not create ten monitors.</h2>
          <p>Service status checks happen once on the server and every browser tab reads the same cached answer. An online endpoint gets one tiny TCP connection every five minutes. Confirmed outages back off to fifteen minutes.</p>
          <ul>
            <li><span>✓</span> Duplicate host and port checks are combined</li>
            <li><span>✓</span> First failures are confirmed before showing red</li>
            <li><span>✓</span> A global switch stops all service checks instantly</li>
            <li><span>✓</span> External websites are never monitored</li>
          </ul>
        </div>
        <div class="cadence-card">
          <p class="card-label">A quiet checking rhythm</p>
          <div class="cadence-row"><span class="pulse good"></span><div><b>Healthy service</b><small>One connect-and-close every 5 minutes</small></div><strong>300s</strong></div>
          <div class="cadence-line"></div>
          <div class="cadence-row"><span class="pulse warn"></span><div><b>First failure</b><small>One confirmation before publishing an outage</small></div><strong>15s</strong></div>
          <div class="cadence-line long"></div>
          <div class="cadence-row"><span class="pulse down"></span><div><b>Confirmed down</b><small>Backs off while the service recovers</small></div><strong>900s</strong></div>
          <p class="cadence-foot">Browser tabs only request the cached summary.</p>
        </div>
      </div>
    </section>

    <section class="section shell install-section" id="install">
      <div class="section-heading centered">
        <p class="eyebrow"><span></span> Small setup, clear steps</p>
        <h2>Three steps. <em>No ceremony.</em></h2>
        <p>Python 3.10 or newer is the only runtime requirement. Run it on a Raspberry Pi, home server, NAS, VM, or a computer you already keep on your network.</p>
      </div>
      <div class="steps">
        {steps.map(([number, title, body]) => (
          <article><span>{number}</span><h3>{title}</h3><p>{body}</p></article>
        ))}
      </div>
      <div class="terminal" role="region" aria-label="TabMonger installation commands">
        <div class="terminal-bar"><i></i><i></i><i></i><span>terminal</span><button class="copy-button" data-copy aria-label="Copy installation commands">Copy</button></div>
        <pre><code id="install-code"><span>git clone</span> https://github.com/truedezigner/tabmonger.git
<span>cd</span> tabmonger
<span>python3</span> server.py --host 0.0.0.0 --port 8787</code></pre>
        <p>Then open <b>http://your-server-ip:8787</b></p>
      </div>
      <div class="install-actions">
        <a class="button button-primary" href={downloadUrl}>Download ZIP</a>
        <a class="button" href={quickStartUrl}>Read the quick start</a>
      </div>
      <aside class="safety-note"><b>Keep it private.</b> TabMonger is designed for your LAN or a protected private network. Do not expose your personal dashboard directly to the public internet without authentication.</aside>
    </section>

    <section class="section downloads-section" id="downloads">
      <div class="shell">
        <div class="section-heading centered downloads-heading">
          <p class="eyebrow"><span></span> App and new-tab companions</p>
          <h2>Start it once.<br /><em>Bring it to every browser.</em></h2>
          <p>Run TabMonger on one trusted computer, then add the small companion for each browser you want to open to your shared dashboard.</p>
        </div>

        <div class="download-grid">
          <article class="download-card app-download-card">
            <div class="download-card-top">
              <span class="platform-mark platform-mac" aria-hidden="true">TM</span>
              <span class="download-kind">TabMonger host</span>
            </div>
            <h3>Run it on macOS</h3>
            <p>Download the complete portable release and keep your dashboard and private data on your Mac.</p>
            <div class="download-actions">
              <a class="button button-primary download-button" href={downloadUrl}>Download for macOS <span aria-hidden="true">↓</span></a>
              <a class="download-source-link" href={macSetupUrl}>Setup and source <span aria-hidden="true">→</span></a>
            </div>
            <small>Requires Python 3.10+. Unzip it, then open <code>Start TabMonger.command</code>.</small>
          </article>

          <article class="download-card">
            <div class="download-card-top">
              <span class="platform-mark platform-chromium" aria-hidden="true"><i></i></span>
              <span class="download-kind">New-tab companion</span>
            </div>
            <h3>Chrome, Brave, and Edge</h3>
            <p>Point every new tab at the TabMonger address already running on your trusted network.</p>
            <div class="download-actions">
              <a class="button download-button" href={chromiumDownloadUrl}>Download for Chrome / Brave / Edge <span aria-hidden="true">↓</span></a>
              <a class="download-source-link" href={chromiumSetupUrl}>Source and setup <span aria-hidden="true">→</span></a>
            </div>
            <small>Unzip it, enable Developer mode, and load the extracted <code>TabMonger-Chromium-extension</code> folder.</small>
          </article>

          <article class="download-card">
            <div class="download-card-top">
              <span class="platform-mark platform-firefox" aria-hidden="true">F</span>
              <span class="download-kind">New-tab companion</span>
            </div>
            <h3>Firefox</h3>
            <p>Use the same lightweight companion without sending your dashboard address to a hosted service.</p>
            <div class="download-actions">
              <a class="button download-button" href={firefoxDownloadUrl}>Download Firefox ZIP <span aria-hidden="true">↓</span></a>
              <a class="download-source-link" href={firefoxSetupUrl}>Source and setup <span aria-hidden="true">→</span></a>
            </div>
            <small>Standard Firefox installation is temporary until Mozilla signing; Firefox removes the manually loaded add-on after restart.</small>
          </article>
        </div>

        <p class="downloads-note">All three downloads come from the public GitHub release. The companion extensions contain no analytics, remote code, accounts, or payment code.</p>
      </div>
    </section>

    <section class="section network-story" id="use-everywhere">
      <div class="shell network-grid">
        <div class="network-copy">
          <p class="eyebrow dark"><span></span> One home, every new tab</p>
          <h2>Run it once.<br />Open it everywhere.</h2>
          <p>Keep TabMonger on one trusted computer, then use its local address from the other computers on your network. Everyone gets the same dashboard without a hosted account or a copy of the app on every machine.</p>
          <div class="network-actions">
            <a class="button button-dark" href={extensionsUrl}>View new-tab companions <span aria-hidden="true">→</span></a>
            <a class="text-link" href={quickStartUrl}>Read the network setup <span aria-hidden="true">→</span></a>
          </div>
        </div>
        <div class="network-flow" aria-label="How TabMonger connects across a local network">
          <article>
            <span class="flow-number">01</span>
            <div><b>Host TabMonger</b><p>Start it on Linux, macOS, Windows, or a small home server.</p></div>
            <code>192.168.x.x:8787</code>
          </article>
          <i aria-hidden="true"></i>
          <article>
            <span class="flow-number">02</span>
            <div><b>Open the local address</b><p>Check that it loads from each browser on the same trusted network.</p></div>
            <span class="flow-state">LAN only</span>
          </article>
          <i aria-hidden="true"></i>
          <article>
            <span class="flow-number">03</span>
            <div><b>Make it your new tab</b><p>Follow the manual install steps for Chrome/Edge or Firefox, then enter the address once.</p></div>
            <span class="flow-state">No cloud</span>
          </article>
        </div>
      </div>
    </section>

    <section class="section shell community-section" id="community">
      <div class="section-heading community-heading">
        <p class="eyebrow"><span></span> Open source means open doors</p>
        <h2>Use it your way.<br /><em>Help shape what comes next.</em></h2>
        <p>TabMonger is free to use, inspect, change, and share. The browser extensions are only one way to build around it—new integrations, importers, themes, docs, and setup helpers are welcome.</p>
      </div>
      <div class="community-grid">
        <a class="community-card" href={`${githubUrl}/issues`}>
          <span>01</span>
          <h3>Share an idea</h3>
          <p>Report a bug, suggest a feature, or explain a setup that TabMonger could serve better.</p>
          <b>Open GitHub Issues <i aria-hidden="true">→</i></b>
        </a>
        <a class="community-card" href={githubUrl}>
          <span>02</span>
          <h3>Improve the project</h3>
          <p>Read the source, improve the documentation, or contribute a focused pull request.</p>
          <b>Explore the source <i aria-hidden="true">→</i></b>
        </a>
        <a class="community-card" href={extensionsUrl}>
          <span>03</span>
          <h3>Build an extension</h3>
          <p>Use the open new-tab companion source as a starting point for another browser or workflow.</p>
          <b>View extension source <i aria-hidden="true">→</i></b>
        </a>
      </div>
      <p class="community-note">New to open source? A clear issue, a tested fix, or a documentation improvement is a real contribution.</p>
    </section>

    <section class="section support-section shell" id="support">
      <div class="support-card">
        <div>
          <p class="eyebrow"><span></span> Keep it independent</p>
          <h2>Free for everyone.<br />Supported by the community.</h2>
          <p>TabMonger will stay free and open source. If it earns a permanent place in your browser, an optional one-time contribution helps cover maintenance, testing, documentation, and the quiet work between releases.</p>
          <p class="support-small">A contribution is always optional and never unlocks features.</p>
        </div>
        <div class="coffee-card">
          <span class="support-icon-wrap"><SupportIcon /></span>
          <h3>Pitch in, if you’d like</h3>
          <p>Help keep the project polished, documented, and welcoming to the next person who discovers it.</p>
          {supportReady ? (
            <a class="button coffee-cta" href={supportUrl} target="_blank" rel="noopener"><SupportIcon /> Make a one-time contribution</a>
          ) : (
            <span class="button coffee-cta is-pending" aria-disabled="true"><SupportIcon /> Contributions opening soon</span>
          )}
          <small>$5 suggested · choose $1–$250 · secure checkout by Stripe</small>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="shell footer-grid">
      <div><Logo /><p>A quiet home for everything you host.</p></div>
      <div><b>Project</b><a href="#features">Features</a><a href="#install">Setup</a><a href="#downloads">Downloads</a><a href={extensionsUrl}>New-tab companion source</a><a href={githubUrl}>Source code</a></div>
      <div><b>Principles</b><span>Private by default</span><span>No telemetry</span><a href="/privacy/">Privacy</a></div>
      <div><b>Community</b><a href={`${githubUrl}/issues`}>Ideas and issues</a>{supportReady ? <a href={supportUrl} target="_blank" rel="noopener">Optional contribution</a> : <span>Contributions opening soon</span>}<a href="/support-policy/">Support policy</a></div>
    </div>
    <div class="shell footer-bottom"><span>© {new Date().getFullYear()} TabMonger</span><span>Built small on purpose.</span></div>
  </footer>

  <script is:inline>
    document.querySelector('[data-copy]')?.addEventListener('click', async (event) => {
      const button = event.currentTarget;
      const text = document.querySelector('#install-code')?.textContent?.trim();
      if (!text) return;
      await navigator.clipboard.writeText(text);
      button.textContent = 'Copied';
      window.setTimeout(() => { button.textContent = 'Copy'; }, 1600);
    });
  </script>
</Layout>
