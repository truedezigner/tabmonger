[Unit]
Description=TabMonger lightweight launch dashboard
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/.local/lib/tabmonger
Environment=TABMONGER_DATA_DIR=%h/.local/share/tabmonger
Environment=TABMONGER_UPLOADS_DIR=%h/.local/share/tabmonger/uploads
ExecStart=/usr/bin/python3 %h/.local/lib/tabmonger/server.py --host 0.0.0.0 --port 8787
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
